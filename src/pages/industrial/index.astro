---
/* Industrial en construcción (01/10/2026). La sesión completa que vivía aquí
   —motor, tres frentes, catálogo, galerías— se retira a pedido del cliente:
   no servía como estaba y la pista se está reconstruyendo por otra vía, a la
   medida de lo que de verdad necesita. Esto es un marcador de sitio, no una
   versión reducida del programa: cuando el contenido real esté listo, esta
   página se reemplaza entera, no se completa encima de esto. */
import Base from '../../layouts/Base.astro';
import Marca from '../../components/Marca.astro';
import Anillo from '../../components/Anillo.astro';
import { marca } from '../../data/spot';
---
<Base
  titulo="Industrial — Spot"
  descripcion="La pista industrial de Spot está en construcción."
  pista="b"
>
  <div class="obra">
    <header class="obra__cinta hoja">
      <Marca href="/" />
      <a class="obra__otra" href="/experiencias/">
        <span class="medida">Pista A</span>
        <span>Experiencias</span>
      </a>
    </header>

    <main class="obra__cuerpo hoja">
      <p class="obra__rail" aria-hidden="true"><b>B</b><i>Pista</i></p>
      <div class="obra__anillo"><Anillo /></div>
      <p class="obra__rotulo">Industrial</p>
      <h1 class="obra__titular">En construcción<em>.</em></h1>
      <p class="obra__plomo">
        Esta pista se está reconstruyendo. Vuelve pronto, o escríbenos
        directamente si tu operación no puede esperar.
      </p>
      <ul class="obra__contacto">
        {marca.correos.map((c) => <li><a href={`mailto:${c}`}>{c}</a></li>)}
        <li><a href={`tel:${marca.telefonoHref}`}>{marca.telefono}</a></li>
      </ul>
      <a class="obra__volver" href="/">Volver a la portada</a>
    </main>
  </div>
</Base>

<style>
  .obra { min-height: 100svh; display: flex; flex-direction: column; }

  .obra__cinta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    padding-block: var(--s2);
    border-bottom: 1px solid var(--rule);
  }
  .obra__otra {
    display: flex;
    align-items: baseline;
    gap: 0.75em;
    font-size: var(--t-chico);
    text-decoration: none;
    color: var(--ink-quiet);
  }
  .obra__otra:hover { color: var(--live); }
  .medida {
    font-size: var(--t-rotulo);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--foil);
  }

  .obra__cuerpo {
    flex: 1;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: var(--s2);
    padding-block: var(--s6);
    position: relative;
  }
  .obra__rail {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.5em;
  }
  .obra__rail b {
    font-family: var(--display);
    font-size: var(--t-rail-letra);
    line-height: 1;
    color: var(--foil);
  }
  .obra__rail i {
    font-style: normal;
    font-size: var(--t-rotulo);
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--ink-quiet);
  }
  .obra__anillo {
    position: absolute;
    top: var(--s6);
    right: var(--gutter);
    width: clamp(6rem, 16vw, 11rem);
    height: clamp(6rem, 16vw, 11rem);
    color: var(--foil-faint);
    opacity: 0.5;
  }
  .obra__rotulo {
    margin: var(--s3) 0 0;
    font-size: var(--t-sub);
    letter-spacing: 0.02em;
    color: var(--ink-quiet);
  }
  .obra__titular {
    margin-top: var(--s1);
    font-size: var(--t-refran);
    line-height: 1.02;
    letter-spacing: -0.022em;
    max-width: 16ch;
  }
  .obra__titular em { font-style: italic; color: var(--live); }
  .obra__plomo {
    margin-top: var(--s3);
    max-width: var(--measure);
    font-size: var(--t-lead);
    line-height: 1.58;
    color: var(--ink-body);
  }
  .obra__contacto {
    margin-top: var(--s4);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3);
  }
  .obra__contacto a {
    font-family: var(--display);
    font-size: var(--t-entrada);
    text-decoration: none;
    border-bottom: 1px solid var(--foil-dim);
    color: var(--ink);
  }
  .obra__contacto a:hover { color: var(--live); border-bottom-color: var(--live); }
  .obra__volver {
    margin-top: var(--s5);
    font-size: var(--t-rotulo);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-quiet);
    text-decoration: none;
  }
  .obra__volver:hover { color: var(--live); }

  @media (max-width: 40rem) {
    .obra__anillo { display: none; }
    .obra__titular { font-size: clamp(2.25rem, 11vw, 3.5rem); }
  }
</style>
