---
import Mundo from '../../layouts/Mundo.astro';
import Sesion from '../../components/Sesion.astro';
import Apertura from '../../components/Apertura.astro';
import Anillo from '../../components/Anillo.astro';
import Muro from '../../components/Muro.astro';
import Sala from '../../components/Sala.astro';
import Galeria from '../../components/Galeria.astro';
import { metodo } from '../../data/spot';
import { industrial } from '../../data/industrial';
import { clientesUnificados } from '../../data/clientes-unificados';

/* Las diez sesiones de esta pista, para el hilo de capítulos de la cinta.
   El rótulo es el mismo que lleva el raíl de cada sesión. */
const capitulos = [
  { n: 'I',    rotulo: 'Qué hacemos',    id: 'frentes' },
  { n: 'II',   rotulo: 'Productos',      id: 'productos' },
  { n: 'III',  rotulo: 'Servicios',      id: 'servicios' },
  { n: 'IV',   rotulo: 'A la medida',    id: 'medida' },
  { n: 'V',    rotulo: 'Software',       id: 'software' },
  { n: 'VI',   rotulo: 'Dónde operamos', id: 'cobertura' },
  { n: 'VII',  rotulo: 'La herencia',    id: 'herencia' },
  { n: 'VIII', rotulo: 'El método',      id: 'metodo' },
  { n: 'IX',   rotulo: 'Proyectos',      id: 'proyectos' },
  { n: 'X',    rotulo: 'Hablemos',       id: 'hablemos' },
];

const { tesis, frentes, productos, servicios, medida, software, demarcacion, cobertura, herencia, contacto } = industrial;

/* Nueve fotogramas del propio catálogo, recortados a la misma caja que los de
   la sala de la Pista A y con el mismo criterio: sin caras reconocibles. Son
   instalaciones reales de la casa, no fotografía de banco. */
const taller = [
  { archivo: 'deck-plataforma', alt: 'Deck de carga con ball transfers instalado en plataforma de aeropuerto, con aeronaves de carga al fondo.' },
  { archivo: 'avion-noche',     alt: 'Aeronave en posición de noche junto a la pasarela, sobre plataforma demarcada.' },
  { archivo: 'rodillos',        alt: 'Línea de rodillos sobre bastidor rojo, vista a ras.' },
  { archivo: 'soldadura',       alt: 'Soldadura en taller sobre lámina, con el arco encendido.' },
  { archivo: 'ball-transfer',   alt: 'Superficie de ball transfers en detalle, con guía naranja al borde.' },
  { archivo: 'deck-perforado',  alt: 'Decks metálicos perforados alineados antes de su instalación.' },
  { archivo: 'terminal',        alt: 'Bahía de terminal de carga con las guías del deck montadas.' },
  { archivo: 'deck-rayado',     alt: 'Deck de rodillos con bandas de demarcación amarillas.' },
  { archivo: 'demarcacion',     alt: 'Piso de bodega demarcado, con viga guía amarilla a lo largo del carril.' },
];

/* Obra en sitio, septiembre 2026: nueve fotografías entregadas por Mauricio
   Altamar (`Recursos_Industries/`, fuera del repositorio), convertidas a
   `public/taller-2026/`. Cerramientos de seguridad y estaciones de pesaje en
   instalación real — distinto material del catálogo 2026 que alimenta
   `taller`. */
const obraReciente = [
  { archivo: 'deck-camion', alt: 'Deck de rodillos instalado en el furgón de un cliente, visto desde la puerta trasera.' },
  { archivo: 'jaula-interior', alt: 'Cerramiento de seguridad para máquina, visto desde dentro en planta.' },
  { archivo: 'jaula-planta', alt: 'Cerramiento de seguridad instalado en planta, vista general.' },
  { archivo: 'jaula-almacen', alt: 'Cerramiento de seguridad con estibas resguardadas en su interior.' },
  { archivo: 'jaula-instalacion', alt: 'Instalación del cerramiento de seguridad, con personal en obra.' },
  { archivo: 'corredor-malla', alt: 'Corredor de malla de seguridad a lo largo de la planta.' },
  { archivo: 'instalacion-escalera', alt: 'Técnico instalando la malla superior del cerramiento desde una escalera.' },
  { archivo: 'jaula-doble-puerta', alt: 'Cerramiento de seguridad con doble puerta corrediza, ya instalado.' },
  { archivo: 'estaciones-pesaje', alt: 'Línea de estaciones de pesaje lista para operar.' },
];
---
<Mundo
  pista="b"
  nombre="Industrial"
  capitulos={capitulos}
  titulo="Industrial — Spot"
  descripcion="Setenta y cinco años al servicio de la industria nacional. Sistemas para movilización de carga, estanterías, equipos de medición, mantenimiento y calibración, y fabricación a la medida. Cobertura nacional."
  fondo="claro"
  videoClaro="/video/industrial-con-dhl.mp4"
  posterClaro="/video/industrial-con-dhl-poster.webp"
>
  <Apertura slot="apertura" letra="B" pista="Industrial">
    <h1 slot="titular" class="titular">
      {tesis.titular[0]}<br /><em>{tesis.titular[1]}</em>
    </h1>
    <p slot="titular" class="nota apertura__tradicion">{tesis.tradicion}</p>
    <p slot="plomo" class="plomo">{tesis.cuerpo}</p>
    <div slot="acciones">
      <a class="apertura__accion apertura__accion--viva" href="#hablemos">Hablemos</a>
      <a class="apertura__accion" href="#productos">Ver productos</a>
    </div>
    <ol slot="tira" class="tira">
      {frentes.map((f) => (
        <li>
          <b>{f.n}</b>
          <span><a href={f.ancla}>{f.titulo}</a></span>
        </li>
      ))}
    </ol>
  </Apertura>

  <figure class="prueba">
    <figcaption class="prueba__pie">
      Treinta y cuatro operaciones <em>que ya pesan con nosotros.</em>
    </figcaption>
    <Muro logos={clientesUnificados} orientacion="horizontal" />
  </figure>

  <section class="motor">
    <div class="motor__negro">
      <p class="motor__afirmacion">El método <em>no cambia</em> de pista.</p>
    </div>
    <div class="motor__claro">
      <h2 class="subtitular">Cinco estaciones.<br /><em>Un mismo criterio.</em></h2>
      <p class="plomo">
        Las cinco estaciones que dirigen un summit dirigen también un proyecto
        industrial. Lo que cambia es qué se mide al final.
      </p>
      <ol class="motor__pasos">
        {metodo.map((m) => (
          <li><b>{m.n}</b><span>{m.titulo}</span></li>
        ))}
      </ol>
      <a class="apertura__accion apertura__accion--viva motor__enlace" href="#metodo">Ver el método completo</a>
    </div>
  </section>

  <Sesion n="I" rotulo="Qué hacemos" id="frentes">
    <h2 class="subtitular subtitular--grande">Tres frentes.<br /><em>Un mismo taller detrás.</em></h2>
    <ol class="pestanas">
      {frentes.map((f) => (
        <li><a href={f.ancla}><b>{f.n}</b><span>{f.titulo}</span></a></li>
      ))}
    </ol>
    <ol class="frentes">
      {frentes.map((f) => (
        <li class="frente entra">
          <span class="frente__n">{f.n}</span>
          <h3 class="frente__titulo"><a href={f.ancla}>{f.titulo}</a></h3>
          <p class="frente__cuerpo">{f.cuerpo}</p>
        </li>
      ))}
    </ol>
    <p slot="margen">Los tres frentes son los del catálogo de productos y servicios 2026.</p>
  </Sesion>

  <Sala
    fijos={taller}
    carpeta="taller"
    titulo="Instalaciones propias"
    pie="Fotografía del catálogo Spot Industries 2026."
  />

  <Galeria
    fotos={obraReciente}
    carpeta="taller-2026"
    titulo="Obra en sitio"
    pie="Fotografía propia, septiembre 2026."
  />

  <div class="afirmacion corchete">
    <div class="afirmacion__decir">
      <h2 class="titular afirmacion__titulo">Diseñamos, fabricamos<br /><em>y mantenemos.</em></h2>
      <a class="apertura__accion apertura__accion--viva" href="#productos">Ver el catálogo</a>
    </div>
    <p class="afirmacion__cuerpo">{tesis.cuerpo}</p>
  </div>

  <Sesion n="II" rotulo="Productos" id="productos">
    <h2 class="subtitular">Lo que mueve, almacena <em>y pesa.</em></h2>
    <ol class="familias">
      {productos.map((p) => (
        <li class="familia entra">
          <span class="familia__n">{p.n}</span>
          <h3 class="familia__titulo">{p.titulo}</h3>
          <p class="familia__cuerpo">{p.cuerpo}</p>
          {p.detalle.length > 0 && (
            <ul class="familia__detalle">
              {p.detalle.map((d) => <li>{d}</li>)}
            </ul>
          )}
        </li>
      ))}
    </ol>
    <p slot="margen">Nueve familias declaradas en el catálogo. Cada una se fabrica también a la medida.</p>
  </Sesion>

  <Sesion n="III" rotulo="Servicios" id="servicios">
    <h2 class="subtitular">Un equipo que mide mal <em>cuesta más que uno parado.</em></h2>
    <p class="plomo servicios__plomo">
      Personal técnico propio para el mantenimiento, y laboratorios acreditados
      ONAC para la calibración. La acreditación es del laboratorio aliado, no
      de la casa: se dice como es.
    </p>
    <ol class="servicios">
      {servicios.map((s) => (
        <li class="servicio entra">
          <span class="servicio__n">{s.n}</span>
          <h3 class="servicio__titulo">{s.titulo}</h3>
          <p class="servicio__cuerpo">{s.cuerpo}</p>
        </li>
      ))}
    </ol>
  </Sesion>

  <Sesion n="IV" rotulo="A la medida" id="medida">
    <h2 class="subtitular">Cuando el catálogo <em>no lo resuelve.</em></h2>
    <p class="plomo">
      Diseño y fabricación sobre el requerimiento de cada cliente. Lo que sale
      del taller cuando la pieza que hace falta no existe todavía.
    </p>
    <ul class="piezas">
      {medida.piezas.map((p) => (
        <li class="pieza entra">
          <span class="pieza__marca"><Anillo /></span>
          <span>{p}</span>
        </li>
      ))}
    </ul>
    <p slot="margen">{medida.remate}</p>
  </Sesion>

  <Sesion n="V" rotulo="Software" id="software">
    <h2 class="subtitular">La medición <em>también se administra.</em></h2>
    <div class="par">
      <div class="par__entrada entra">
        <h3 class="par__titulo">{software.titulo}</h3>
        <p class="par__cuerpo">{software.cuerpo}</p>
      </div>
      <div class="par__entrada entra">
        <h3 class="par__titulo">{demarcacion.titulo}</h3>
        <p class="par__cuerpo">{demarcacion.cuerpo}</p>
      </div>
    </div>
  </Sesion>

  <Sesion n="VI" rotulo="Dónde operamos" id="cobertura">
    <h2 class="subtitular">{cobertura.titulo}.</h2>
    <ul class="ciudades">
      {cobertura.ciudades.map((c) => <li class="entra">{c}</li>)}
    </ul>
    <p class="nota ciudades__nota">{cobertura.nota}</p>
  </Sesion>

  <Sesion n="VII" rotulo="La herencia" id="herencia">
    <h2 class="subtitular">{herencia.titulo}</h2>
    <p class="plomo">{herencia.cuerpo}</p>
    <p slot="margen">{herencia.nota}</p>
  </Sesion>

  <Sesion n="VIII" rotulo="El método" id="metodo">
    <h2 class="subtitular">El método no cambia de pista.</h2>
    <p class="plomo metodo__plomo">
      Las cinco estaciones que dirigen un summit dirigen también un proyecto
      industrial. Lo que cambia es qué se mide al final.
    </p>
    <ol class="metodo">
      {metodo.map((m) => (
        <li class="paso entra">
          <span class="paso__n">{m.n}</span>
          <h3 class="paso__titulo">{m.titulo}</h3>
          <p class="paso__cuerpo">{m.cuerpo}</p>
        </li>
      ))}
    </ol>
  </Sesion>

  <Sesion n="IX" rotulo="Proyectos" id="proyectos" class="sesion--pendiente">
    <h2 class="subtitular">Próximamente.</h2>
    <p class="plomo">
      Dos o tres proyectos reales, con resultado verificable. Se publican
      cuando existan confirmados, no antes.
    </p>
    <p slot="margen">Ocupará su sitio en cuanto exista, sin rehacer el programa.</p>
  </Sesion>

  <Sesion n="X" rotulo="Hablemos" id="hablemos" class="sesion--cierre">
    <div class="cierre">
      <div class="cierre__decir corchete">
        <h2 class="titular">¿Listo para que su operación<br /><em>no se detenga?</em></h2>
        <p class="plomo">
          Si su operación tiene una decisión pendiente y no un pliego de compras,
          esta es la conversación correcta.
        </p>
        <ul class="contacto">
          <li>
            <a class="contacto__enlace" href={`tel:${contacto.oficinaHref}`}>{contacto.oficina}</a>
            <i class="contacto__rotulo">Oficina</i>
          </li>
          {contacto.moviles.map((m) => (
            <li>
              <a class="contacto__enlace" href={`tel:${m.href}`}>{m.numero}</a>
              <i class="contacto__rotulo">Móvil</i>
            </li>
          ))}
          {contacto.correos.map((c) => (
            <li><a class="contacto__enlace" href={`mailto:${c}`}>{c}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </Sesion>
</Mundo>

<style>
  .metodo__plomo, .servicios__plomo { margin-top: var(--s2); }

  /* La tira de la apertura: los tres frentes del catálogo, que es el índice
     de la casa. */
  .tira {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s3) var(--s4);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .tira li { display: grid; gap: 0.25rem; }
  .tira b {
    font-family: var(--display);
    font-style: italic;
    font-weight: 400;
    font-size: var(--t-sub);
    line-height: 1;
    color: var(--foil);
  }
  .tira span {
    font-size: var(--t-micro);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .tira a { text-decoration: none; }

  /* El motor: explicador a dos columnas, como «The Dill Autonomy Engine» de
     picklerobot.com — panel oscuro con la afirmación, panel claro con el
     contenido. Aquí el motor real de la casa es el método, no un algoritmo:
     traducido con lo que hay, no con lo que Pickle tiene. */
  .motor {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: var(--s6);
  }
  .motor__negro {
    display: grid;
    align-content: center;
    padding: var(--s5) var(--gutter);
  }
  .motor__afirmacion {
    font-family: var(--display);
    font-style: italic;
    font-size: clamp(1.75rem, 3.4vw, 2.6rem);
    line-height: 1.18;
    color: var(--ink);
    max-width: 18ch;
  }
  .motor__afirmacion em { color: var(--live); }
  .motor__claro {
    padding: var(--s5) var(--gutter);
    background: var(--placa);
  }
  .motor__pasos {
    margin-top: var(--s4);
    display: grid;
    gap: 0.6rem;
  }
  .motor__pasos li { display: flex; align-items: baseline; gap: 0.7em; }
  .motor__pasos b {
    font-family: var(--display);
    font-style: italic;
    color: var(--foil);
    font-size: var(--t-chico);
  }
  .motor__enlace { margin-top: var(--s4); }

  @media (max-width: 52rem) {
    .motor { grid-template-columns: 1fr; }
  }

  /* Las pestañas: navegación rápida a los tres frentes, con el aire de la
     barra de pestañas de picklerobot.com — sin JavaScript de por medio,
     porque cada una ya salta a su propia sesión completa más abajo; esto
     es la promesa visual, la sesión de siempre sigue siendo el contenido. */
  .pestanas {
    margin-top: var(--s4);
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0;
    border: 1px solid var(--rule);
  }
  .pestanas li { border-right: 1px solid var(--rule); }
  .pestanas li:last-child { border-right: 0; }
  .pestanas a {
    display: flex;
    align-items: baseline;
    gap: 0.5em;
    padding: 0.85em 1.4em;
    text-decoration: none;
    font-family: var(--mono);
    font-size: var(--t-rotulo);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-quiet);
    transition: background-color 220ms var(--ease), color 220ms var(--ease);
  }
  .pestanas a:hover { background: var(--placa); color: var(--ink); }
  .pestanas b { font-family: var(--mono); color: var(--live); }
  /* La primera pestaña llena de luz por defecto, como «AUTONOMY» en
     picklerobot.com: no todo estado activo tiene que decidirlo el scroll. */
  .pestanas li:first-child a { background: var(--live); color: var(--stock); }
  .pestanas li:first-child a:hover { background: var(--live); color: var(--stock); }
  .pestanas li:first-child b { color: var(--stock); }

  /* La afirmación intermedia: el «We Pick Things» de Pickle, con lo que la
     casa puede probar de sí misma en una frase, no en una promesa suelta. */
  .afirmacion {
    margin-top: var(--s6);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s5);
    align-items: center;
  }
  .afirmacion__titulo { margin-bottom: var(--s3); }
  .afirmacion__titulo em { color: var(--live); }
  .afirmacion__cuerpo { font-size: var(--t-lead); max-width: 42ch; }

  @media (max-width: 52rem) {
    .afirmacion { grid-template-columns: 1fr; gap: var(--s3); }
  }

  /* Los tres frentes: entradas de programa, como las prácticas de la Pista A. */
  .frentes { margin-top: var(--s4); }
  .frente {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.35rem var(--s3);
    padding-block: var(--s4);
    border-top: 1px solid var(--rule);
  }
  .frente__n {
    grid-row: span 2;
    font-family: var(--display);
    font-style: italic;
    font-size: var(--t-practica-n);
    opacity: 0.55;
    text-align: right;
    color: var(--foil);
    line-height: 1;
    font-variation-settings: 'opsz' 18;
  }
  .frente__titulo {
    font-size: var(--t-titulo);
    line-height: 1.1;
    font-variation-settings: 'opsz' 30;
  }
  .frente__titulo a { text-decoration: none; border-bottom: 1px solid var(--foil-dim); }
  .frente__cuerpo { max-width: 52ch; }

  /* Las nueve familias. El detalle va en versalitas de latón, en línea: es
     nomenclatura de catálogo, no texto de lectura. */
  .familias { margin-top: var(--s4); }
  .familia {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr);
    gap: 0.3rem var(--s3);
    padding-block: var(--s3);
    border-top: 1px solid var(--rule);
  }
  .familia__n {
    grid-row: span 3;
    font-family: var(--display);
    font-style: italic;
    font-size: var(--t-sub);
    color: var(--foil);
    line-height: 1.2;
    font-variation-settings: 'opsz' 15;
  }
  .familia__titulo {
    font-size: var(--t-entrada);
    line-height: 1.14;
    font-variation-settings: 'opsz' 25;
  }
  .familia__cuerpo { max-width: 56ch; font-size: var(--t-chico); }
  /* El detalle corre como una sola línea de texto, no como una rejilla de
     etiquetas: en columna estrecha, siete nombres en caja alta y con prosa
     ocupaban nueve renglones, uno por etiqueta. Como texto corrido se acomodan
     solos y siguen leyéndose como nomenclatura de catálogo. */
  .familia__detalle {
    margin-top: var(--s1);
    font-size: var(--t-menudo);
    letter-spacing: 0.14em;
    line-height: 1.7;
    text-transform: uppercase;
    color: var(--foil);
  }
  .familia__detalle li { display: inline; }
  .familia__detalle li + li::before { content: ' · '; color: var(--foil-dim); }

  /* Los servicios: cadena de cinco, con el mismo hilo que la metodología.
     Es un mantenimiento, y un mantenimiento es una secuencia. */
  .servicios {
    margin-top: var(--s4);
    position: relative;
    padding-left: var(--s4);
  }
  .servicios::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 0.9rem;
    bottom: 1.1rem;
    width: 1px;
    background: linear-gradient(to bottom, var(--live), var(--foil-faint));
  }
  .servicio {
    position: relative;
    display: grid;
    gap: 0.3rem;
    padding-block: var(--s2) var(--s3);
  }
  .servicio::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--s4) + 2px);
    top: 1.15rem;
    width: 7px;
    height: 7px;
    background: var(--stock);
    border: 1px solid var(--live);
    border-radius: 50%;
  }
  .servicio__n {
    font-family: var(--display);
    font-style: italic;
    font-size: var(--t-menudo);
    letter-spacing: 0.12em;
    color: var(--foil);
  }
  .servicio__titulo { font-size: var(--t-menor); line-height: 1.15; }
  .servicio__cuerpo { max-width: 54ch; }

  /* Las piezas a la medida: el anillo como viñeta, en dos columnas. */
  .piezas {
    margin-top: var(--s4);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s2) var(--s4);
  }
  .pieza {
    display: grid;
    grid-template-columns: 1rem minmax(0, 1fr);
    align-items: baseline;
    gap: var(--s2);
    padding-block: var(--s2);
    border-top: 1px solid var(--rule);
    font-family: var(--display);
    font-size: var(--t-menor);
    line-height: 1.2;
    color: var(--ink);
    font-variation-settings: 'opsz' 18;
  }
  /* Envuelto: una clase suelta sobre `<Anillo />` no recibe el atributo de
     ámbito de la página. */
  .pieza__marca { display: block; width: 0.6rem; height: 0.6rem; color: var(--live); }
