---
import Base from './Base.astro';
import Marca from '../components/Marca.astro';
import Bruma from '../components/Bruma.astro';
import Pelicula from '../components/Pelicula.astro';
import { marca } from '../data/spot';

interface Props {
  titulo: string;
  descripcion: string;
  pista: 'a' | 'b';
  nombre: string;
  /* 'pelicula' sólo donde hay material real. La Pista B no tiene grabación
     propia todavía, y no se le presta la de la otra pista. */
  fondo?: 'bruma' | 'pelicula';
}
const { titulo, descripcion, pista, nombre, fondo = 'bruma' } = Astro.props;
const otra = pista === 'a'
  ? { nombre: 'Industrial', href: '/industrial/', letra: 'B' }
  : { nombre: 'Experiencias', href: '/experiencias/', letra: 'A' };
const letra = pista === 'a' ? 'A' : 'B';
---
<Base titulo={titulo} descripcion={descripcion} pista={pista}>
  <a class="saltar" href="#contenido">Saltar al contenido</a>

  <header class="cinta">
    <div class="hoja cinta__hoja">
      <Marca href="/" class="cinta__marca" />
      <p class="cinta__pista">
        <span class="medida">Pista {letra}</span>
        <span class="cinta__nombre">{nombre}</span>
      </p>
      <a class="cinta__otra" href={otra.href}>
        <span class="medida">Pista {otra.letra}</span>
        <span>{otra.nombre}</span>
      </a>
    </div>
  </header>

  {fondo === 'pelicula' ? <Pelicula /> : <Bruma pista={pista} />}

  <div class="hoja portadilla">
    <slot name="apertura" />
  </div>

  <main id="contenido" class="hoja programa">
    <span id="programa" class="ancla" aria-hidden="true"></span>
    <slot />
  </main>

  <footer class="pie">
    <div class="hoja pie__hoja">
      <p class="pie__cierre">{marca.cierre.map((l) => <span>{l}</span>)}</p>
      <div class="pie__datos">
        <p class="pie__grupo">
          {marca.correos.map((c) => <a href={`mailto:${c}`}>{c}</a>)}
          <a href={`tel:${marca.telefonoHref}`}>{marca.telefono}</a>
        </p>
        <p class="pie__grupo pie__grupo--quieto">
          <span>{marca.territorios.join(' · ')}</span>
          <a href="/">Volver a la portada</a>
          <a href={otra.href}>Pista {otra.letra} · {otra.nombre}</a>
        </p>
      </div>
    </div>
  </footer>
</Base>

<style>
  .saltar {
    position: absolute;
    left: -9999px;
    top: 0;
    background: var(--live);
    color: var(--stock);
    padding: 0.6rem 1rem;
    z-index: 10;
    text-decoration: none;
  }
  .saltar:focus { left: 0; }

  .cinta {
    position: sticky;
    top: 0;
    z-index: 5;
    background: var(--stock);
    border-bottom: 1px solid var(--rule);
  }
  .cinta__hoja {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s3);
    padding-block: var(--s2);
  }
  .cinta__pista {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.75em;
    min-width: 0;
  }
  .cinta :global(.marca img) { view-transition-name: anillo; }

  .cinta__nombre {
    font-family: var(--display);
    font-size: var(--t-sub);
    color: var(--ink);
    letter-spacing: 0.005em;
  }
  .cinta__otra {
    display: flex;
    align-items: baseline;
    gap: 0.75em;
    font-size: var(--t-chico);
    text-decoration: none;
    color: var(--ink-quiet);
    white-space: nowrap;
  }
  .cinta__otra:hover { color: var(--live); }

  .portadilla { position: relative; z-index: 1; }
  .programa { padding-bottom: var(--s6); z-index: 1; }
  .ancla { display: block; height: 0; scroll-margin-top: 4.5rem; }

  .pie {
    border-top: 1px solid var(--foil-dim);
    background: var(--stock-deep);
  }
  .pie__hoja {
    display: grid;
    gap: var(--s4);
    padding-block: var(--s5) var(--s4);
    grid-template-columns: minmax(0, 1fr) minmax(0, auto);
    align-items: start;
  }
  .pie__cierre {
    margin: 0;
    font-family: var(--display);
    font-size: var(--t-entrada);
    line-height: 1.24;
    color: var(--ink);
    font-variation-settings: 'opsz' 25;
  }
  .pie__cierre span { display: block; }
  .pie__datos { display: grid; gap: var(--s2); justify-items: end; text-align: right; }
  .pie__grupo {
    margin: 0;
    display: grid;
    gap: 0.35em;
    font-size: var(--t-chico);
  }
  .pie__grupo--quieto { color: var(--ink-quiet); font-size: var(--t-menudo); }

  @media (max-width: 52rem) {
    .cinta__pista .medida { display: none; }
    .cinta__otra span:last-child { display: none; }
    .pie__hoja { grid-template-columns: 1fr; }
    .pie__datos { justify-items: start; text-align: left; }
  }
  @media (max-width: 34rem) {
    .cinta__hoja { gap: var(--s2); }
    .cinta__nombre { font-size: var(--t-nota); }
  }
</style>

<script>
  /* El hilo continuo: el numeral de la sesión que el visitante está leyendo se
     enciende. Es toda la orientación que la página necesita. */
  const sesiones = document.querySelectorAll<HTMLElement>('.sesion');
  if (sesiones.length && 'IntersectionObserver' in window) {
    const ojo = new IntersectionObserver(
      (entradas) => {
        for (const e of entradas) {
          e.target.classList.toggle('sesion--viva', e.isIntersecting);
        }
      },
      { rootMargin: '-45% 0px -45% 0px' }
    );
    sesiones.forEach((s) => ojo.observe(s));
  }
</script>
