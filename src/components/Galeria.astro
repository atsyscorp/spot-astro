---
/* La galería: rejilla fija, sin ligarse al scroll — el complemento de `Sala`,
   pedido el 24/09/2026 porque una sola banda que se mueve no basta para
   enseñar nueve fotografías con calma. Aquí no hay gesto: se mira quieto,
   como una hoja de contactos.

   Fotografías propias de obra en sitio, entregadas por Mauricio Altamar el
   24/09/2026 (`Recursos_Industries/`, fuera del repositorio) y convertidas a
   WebP en `public/taller-2026/`. Sin caras reconocibles, igual criterio que
   `Sala`: donde aparece una persona, va pequeña y de espaldas o en plano
   general, nunca en primer plano.

   Ajuste del mismo día: la primera versión recortaba cada foto a una caja
   4:3 fija sin forma de ver el resto — varias vienen en retrato y perdían la
   mitad del cuadro sin remedio. Ahora la miniatura es más baja (recorta más,
   sí, pero pesa menos en la página) y cada una abre un visor a pantalla
   completa con la fotografía entera, sin recortar. */
export interface Foto { archivo: string; alt: string }

interface Props {
  fotos: Foto[];
  carpeta: string;
  titulo: string;
  pie?: string;
}
const { fotos, carpeta, titulo, pie } = Astro.props;
---
<figure class="galeria">
  <figcaption class="galeria__pie">
    <b>{titulo}</b>
    {pie && <span>{pie}</span>}
  </figcaption>
  <div class="galeria__rejilla">
    {fotos.map((f, i) => (
      <button
        type="button"
        class="galeria__disparador"
        data-index={i}
        aria-label={`Ver completa: ${f.alt}`}
      >
        <img
          src={`/${carpeta}/${f.archivo}.webp`}
          alt={f.alt}
          width="1600"
          height="1200"
          loading="lazy"
          decoding="async"
        />
      </button>
    ))}
  </div>

  <div class="galeria__visor" hidden>
    <button type="button" class="galeria__cerrar" aria-label="Cerrar">
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 4l12 12M16 4L4 16" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
    </button>
    <button type="button" class="galeria__paso galeria__paso--atras" aria-label="Anterior">
      <svg viewBox="0 0 12 20" aria-hidden="true"><path d="M10 2 2 10l8 8" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
    </button>
    <figure class="galeria__marco">
      <img class="galeria__grande" src="" alt="" />
      <figcaption class="galeria__leyenda"></figcaption>
    </figure>
    <button type="button" class="galeria__paso galeria__paso--adelante" aria-label="Siguiente">
      <svg viewBox="0 0 12 20" aria-hidden="true"><path d="M2 2l8 8-8 8" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
    </button>
  </div>
</figure>

<style>
  .galeria { margin-block: var(--s5); }

  .galeria__pie {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5em 1.2em;
    margin-bottom: var(--s3);
  }
  .galeria__pie b {
    font-weight: 400;
    font-size: var(--t-rotulo);
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--foil);
  }
  .galeria__pie span {
    font-family: var(--display);
    font-style: italic;
    font-size: var(--t-chico);
    color: var(--ink-quiet);
  }

  .galeria__rejilla {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2px;
    background: var(--placa);
  }
  .galeria__disparador {
    display: block;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .galeria__disparador img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--placa);
    filter: saturate(0.82) brightness(0.86);
    transition: filter 320ms var(--ease);
  }
  .galeria__disparador:hover img,
  .galeria__disparador:focus-visible img { filter: saturate(1) brightness(1); }

  @media (max-width: 62rem) {
    .galeria__rejilla { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  @media (max-width: 40rem) {
    .galeria__rejilla { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* El visor: la fotografía entera, sin recortar. */
  .galeria__visor {
    position: fixed;
    inset: 0;
    z-index: 40;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: var(--s2);
    padding: var(--s3) var(--gutter);
    background: rgba(6, 6, 6, 0.92);
  }
  .galeria__marco {
    grid-column: 2;
    margin: 0;
    display: grid;
    justify-items: center;
    gap: var(--s2);
    max-height: 90svh;
    min-width: 0;
  }
  .galeria__grande {
    max-width: 100%;
    max-height: 78svh;
    width: auto;
    height: auto;
    object-fit: contain;
    background: var(--placa);
  }
  .galeria__leyenda {
    font-family: var(--display);
    font-style: italic;
    font-size: var(--t-chico);
    color: var(--ink-quiet);
    text-align: center;
    max-width: 42rem;
  }

  .galeria__cerrar,
  .galeria__paso {
    border: 0;
    background: none;
    color: var(--ink-quiet);
    padding: var(--s1);
    cursor: pointer;
    transition: color 200ms var(--ease);
  }
  .galeria__cerrar:hover, .galeria__cerrar:focus-visible,
  .galeria__paso:hover, .galeria__paso:focus-visible { color: var(--ink); }

  .galeria__cerrar {
    position: fixed;
    top: var(--s3);
    right: var(--gutter);
  }
  .galeria__cerrar svg { width: 1.15rem; height: 1.15rem; }
  .galeria__paso svg { width: 0.85rem; height: 1.4rem; }
  .galeria__paso--atras { grid-column: 1; }
  .galeria__paso--adelante { grid-column: 3; }

  @media (max-width: 40rem) {
    .galeria__visor { grid-template-columns: 1fr; padding-inline: var(--s2); }
    .galeria__marco { grid-column: 1; }
    .galeria__paso { position: fixed; top: 50%; margin-top: -1.2rem; }
    .galeria__paso--atras { left: var(--s1); }
    .galeria__paso--adelante { right: var(--s1); }
  }
</style>

<script>
  /* Astro deduplica este script si `Galeria` se usa más de una vez en la
     página y lo corre una sola vez — por eso conecta cada `.galeria` que
     encuentre en el DOM, en vez de asumir que hay una sola. */
  for (const figura of document.querySelectorAll<HTMLElement>('.galeria')) {
      const disparadores = Array.from(figura.querySelectorAll<HTMLButtonElement>('.galeria__disparador'));
      const visor = figura.querySelector<HTMLElement>('.galeria__visor')!;
      const grande = visor.querySelector<HTMLImageElement>('.galeria__grande')!;
      const leyenda = visor.querySelector<HTMLElement>('.galeria__leyenda')!;
      const cerrar = visor.querySelector<HTMLButtonElement>('.galeria__cerrar')!;
      const atras = visor.querySelector<HTMLButtonElement>('.galeria__paso--atras')!;
      const adelante = visor.querySelector<HTMLButtonElement>('.galeria__paso--adelante')!;

      let activo = -1;

      const abrir = (i: number) => {
        activo = (i + disparadores.length) % disparadores.length;
        const img = disparadores[activo].querySelector('img')!;
        grande.src = img.src;
        grande.alt = img.alt;
        leyenda.textContent = img.alt;
        visor.hidden = false;
      };
      const salir = () => {
        visor.hidden = true;
        grande.src = '';
        if (activo >= 0) disparadores[activo].focus();
        activo = -1;
      };

      disparadores.forEach((b, i) => b.addEventListener('click', () => abrir(i)));
      cerrar.addEventListener('click', salir);
      atras.addEventListener('click', () => abrir(activo - 1));
      adelante.addEventListener('click', () => abrir(activo + 1));
      visor.addEventListener('click', (e) => { if (e.target === visor) salir(); });
      window.addEventListener('keydown', (e) => {
        if (visor.hidden) return;
        if (e.key === 'Escape') salir();
        else if (e.key === 'ArrowLeft') abrir(activo - 1);
        else if (e.key === 'ArrowRight') abrir(activo + 1);
      });
  }
</script>
