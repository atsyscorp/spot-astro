---
/* El logotipo oficial, tal como lo entregó el cliente:
   `spot-main-logo-white-1024x482.webp`, blanco sobre transparencia, recortado
   a la caja exacta del dibujo. No se reconstruye con tipografía: la geométrica
   del logotipo no es ninguna de las dos familias del sitio.
   La 'o' es el mismo anillo que `brand/spot-ring.svg` — verificado. */
interface Props { href?: string | null; class?: string }
const { href = '/', class: clase = '' } = Astro.props;
const src = '/brand/spot-wordmark-white.webp';
---
{href ? (
  <a class:list={['marca', clase]} href={href}>
    <img src={src} alt="Spot — volver a la portada" width="1024" height="482" decoding="async" />
  </a>
) : (
  <span class:list={['marca', clase]}>
    <img src={src} alt="Spot" width="1024" height="482" decoding="async" />
  </span>
)}

<style is:global>
  .marca {
    display: inline-block;
    line-height: 0;
    text-decoration: none;
  }
  .marca img {
    width: auto;
    height: var(--marca-alto, 1.75rem);
    opacity: 0.94;
    transition: opacity 200ms var(--ease), filter 200ms var(--ease);
  }
  a.marca:hover img { opacity: 1; }

  /* El logotipo que entregó el cliente es blanco sobre transparente: no
     sirve tal cual sobre el papel claro de la Pista B. Se invierte por CSS
     —blanco a negro, sin tocar el alfa— en vez de pedir un segundo archivo:
     es la misma geometría exacta, sólo con la tinta que le toca al fondo. */
  [data-pista='b'] .marca img { filter: invert(1); }
</style>
