---
/* La vitrina: fondo claro con vídeo propio detrás, para la apertura de
   Industrial.

   Pedido explícito el 19/09/2026: «cambiar el fondo del spot industries a
   blanco... para que se dé un contraste más fuerte», con un vídeo de fondo
   con opacidad (Camilo Altamar). Mauricio Altamar entregó el material el
   24/09/2026 — 4K, 37s, el deck de rodillos visto desde dentro de un furgón
   de DHL — y el usuario eligió esa toma completa en vez del encuadre que la
   dejaba fuera de cuadro (ambos recortes siguen existiendo: ver
   `public/video/industrial-sin-dhl.mp4`).

   Carga como `Pelicula`, la misma pieza de Experiencias: el vídeo no se pide
   solo, lo pone el script y sólo si el visitante no pidió menos movimiento,
   no está ahorrando datos, la conexión no es lenta y la pantalla da el
   ancho. Hasta entonces, y siempre en móvil, lo que se ve es el poster.

   Misma altura que `Bruma`, pero sin su remate: desde el 24/09/2026 toda la
   Pista B es papel claro (`tokens.css`, remapeo de `[data-pista='b']`), así
   que no hay una cartulina oscura debajo con la que fundirse — el vídeo sólo
   se apaga hacia el mismo papel que ya trae el programa.

   ADVERTENCIA que no se resuelve desde el código: el furgón lleva el
   logotipo de DHL a la vista, y DHL no tiene autorización de marca
   confirmada (mismo pendiente que el muro de clientes, ver `ENTREGA.md`).
   Publicar esto en abierto sin esa confirmación es la misma clase de riesgo
   que el resto del muro — no uno nuevo, pero tampoco uno resuelto. */
interface Props { video: string; poster: string }
const { video, poster } = Astro.props;
---
<div class="vitrina" aria-hidden="true">
  <video
    class="vitrina__cinta"
    poster={poster}
    muted
    loop
    playsinline
    preload="none"
    data-src={video}
  ></video>
</div>

<style>
  .vitrina {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 92svh;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: var(--stock);
  }

  .vitrina__cinta {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    opacity: 0.4;
  }

  /* Lava el vídeo para que el titular no compita con él. */
  .vitrina::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, transparent 0%, var(--stock) 62%);
  }
</style>

<script>
  const capa = document.querySelector<HTMLElement>('.vitrina');
  const cinta = capa?.querySelector<HTMLVideoElement>('.vitrina__cinta');

  if (cinta) {
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const estrecho = window.matchMedia('(max-width: 52rem)').matches;
    const conexion = (navigator as any).connection;
    const ahorro = Boolean(conexion?.saveData);
    const lenta = /(^|\W)(slow-2g|2g|3g)$/.test(conexion?.effectiveType ?? '');

    if (!quieto && !estrecho && !ahorro && !lenta) {
      const src = cinta.dataset.src;
      if (src) {
        cinta.src = src;
        cinta.load();
        cinta.play().catch(() => { /* si el navegador lo bloquea, queda el poster */ });
      }
    }
  }
</script>
