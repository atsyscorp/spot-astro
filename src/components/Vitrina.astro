---
/* La vitrina: el vídeo propio detrás de la apertura de Industrial.

   Pedido explícito el 19/09/2026: «un video de fondo con opacidad»
   (Camilo Altamar). Mauricio Altamar entregó el material el 24/09/2026 —
   4K, 37s, el deck de rodillos visto desde dentro de un furgón de DHL — y el
   usuario eligió esa toma completa en vez del encuadre que la dejaba fuera
   de cuadro (ambos recortes siguen existiendo: ver
   `public/video/industrial-sin-dhl.mp4`).

   Carga como `Pelicula`, la misma pieza de Experiencias: el vídeo no se pide
   solo, lo pone el script y sólo si el visitante no pidió menos movimiento,
   no está ahorrando datos, la conexión no es lenta y la pantalla da el
   ancho. Hasta entonces, y siempre en móvil, lo que se ve es el poster.

   Vivió sobre papel claro del 24/09 al 26/09/2026; ese remapeo se revirtió
   en `tokens.css` (picklerobot.com como referencia, cliente pidió volver a
   cartulina negra). Misma altura y el mismo remate que `Bruma`: `--stock`
   vuelve a ser el negro real, así que el vídeo se apaga hacia la cartulina
   como antes del 24/09, sin necesitar un caso especial.

   ADVERTENCIA que no se resuelve desde el código: el furgón lleva el
   logotipo de DHL a la vista, y DHL no tiene autorización de marca
   confirmada (mismo pendiente que el muro de clientes, ver `ENTREGA.md`).
   Publicar esto en abierto sin esa confirmación es la misma clase de riesgo
   que el resto del muro — no uno nuevo, pero tampoco uno resuelto. */
interface Props { video: string; poster: string }
const { video, poster } = Astro.props;
---
<div class="vitrina" aria-hidden="true">
  <video
    class="vitrina__cinta"
    poster={poster}
    muted
    loop
    playsinline
    preload="none"
    data-src={video}
  ></video>
</div>

<style>
  .vitrina {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 92svh;
    z-index: 0;
    overflow: hidden;
    pointer-events: none;
    background: var(--stock);
  }

  .vitrina__cinta {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    opacity: 0.62;
  }

  /* El deck en movimiento es la prueba, no una atmósfera: se ve fuerte del
     lado derecho, donde no hay texto, y se apaga hacia la izquierda —donde
     se lee el titular— y hacia abajo, donde empieza el programa. */
  .vitrina::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to right, var(--stock) 0%, color-mix(in srgb, var(--stock) 60%, transparent) 48%, transparent 76%),
      linear-gradient(to bottom, transparent 0%, transparent 55%, var(--stock) 84%);
  }
  @supports not (background: color-mix(in srgb, red 50%, transparent)) {
    .vitrina::after {
      background: linear-gradient(to bottom, transparent 0%, transparent 55%, var(--stock) 84%);
    }
  }

  @media (max-width: 52rem) {
    /* Angosto no tiene lado limpio: la columna se apaga entera, más suave. */
    .vitrina__cinta { opacity: 0.4; }
    .vitrina::after {
      background: linear-gradient(to bottom, transparent 0%, var(--stock) 60%);
    }
  }
</style>

<script>
  const capa = document.querySelector<HTMLElement>('.vitrina');
  const cinta = capa?.querySelector<HTMLVideoElement>('.vitrina__cinta');

  if (cinta) {
    const quieto = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const estrecho = window.matchMedia('(max-width: 52rem)').matches;
    const conexion = (navigator as any).connection;
    const ahorro = Boolean(conexion?.saveData);
    const lenta = /(^|\W)(slow-2g|2g|3g)$/.test(conexion?.effectiveType ?? '');

    if (!quieto && !estrecho && !ahorro && !lenta) {
      const src = cinta.dataset.src;
      if (src) {
        cinta.src = src;
        cinta.load();
        cinta.play().catch(() => { /* si el navegador lo bloquea, queda el poster */ });
      }
    }
  }
</script>
